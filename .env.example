# ─── GATE CS & IT PYQ Platform — Environment Variables Reference ───
# Copy this file to `.env` locally. NEVER commit a real `.env` file.

# ─── Database (PostgreSQL, used by Prisma + backend) ───
# postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gate_pyq

# ─── Backend ───
# Port the backend API server listens on.
PORT=4000

# Base URL of the backend API, as reachable from the browser (frontend → backend).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Approved browser origin for credentialed CORS requests.
FRONTEND_ORIGIN=http://localhost:3000

# ─── Application ───
# Runtime environment: development | test | production
NODE_ENV=development